 style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=14;fontColor=#FFFFFF;fillColor=none;strokeColor=none;" parent="card_User" vertex="1"><mxGeometry x="7" y="43" width="316" height="63" as="geometry"/></mxCell><mxCell id="ntbg_111" value="" style="rounded=1;arcSize=7;fillColor=#0F2538;strokeColor=#284B67;strokeWidth=1;" parent="1" vertex="1"><mxGeometry x="490" y="858" width="625" height="132" as="geometry"/></mxCell><mxCell id="txt_112" value="&lt;b&gt;Referencias transversales&lt;/b&gt;&lt;br/&gt;User aparece como actor de auditoría en diversos modelos.&lt;br/&gt;Las relaciones detalladas se muestran en las páginas siguientes.&lt;br/&gt;El modelo de datos no equivale a todas las clases Python del proyecto." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=4;fontFamily=Arial;fontSize=16;fontColor=#FFFFFF;fontStyle=0;fillColor=none;strokeColor=none;" parent="1" vertex="1"><mxGeometry x="502" y="866" width="601" height="117" as="geometry"/></mxCell><mxCell id="ntbg_113" value="" style="rounded=1;arcSize=7;fillColor=#0F2538;strokeColor=#284B67;strokeWidth=1;" parent="1" vertex="1"><mxGeometry x="95" y="1075" width="1020" height="220" as="geometry"/></mxCell><mxCell id="txt_114" value="&lt;b&gt;Lectura del mapa&lt;/b&gt;&lt;br/&gt;Inventario: activos, sistemas, instalaciones y vínculos históricos.&lt;br/&gt;Capturas: observaciones importadas vs. comunicaciones consolidadas.&lt;br/&gt;Vulnerabilidades: candidatos, catálogos, hallazgos y evaluaciones.&lt;br/&gt;Las cinco páginas son partes del mismo diagrama editable." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=4;fontFamily=Arial;fontSize=16;fontColor=#FFFFFF;fontStyle=0;fillColor=none;strokeColor=none;" parent="1" vertex="1"><mxGeometry x="107" y="1083" width="996" height="205" as="geometry"/></mxCell><mxCell id="ntbg_115" value="" style="rounded=1;arcSize=7;fillColor=#0F2538;strokeColor=#284B67;strokeWidth=1;" parent="1" vertex="1"><mxGeometry x="1250" y="1288" width="1030" height="60" as="geometry"/></mxCell><mxCell id="txt_116" value="&lt;b&gt;Alcance&lt;/b&gt;&lt;br/&gt;Se incluyen 25 clases concretas de models.py / assets.models / vulnerabilities.models.&lt;br/&gt;Las tarjetas de detalle muestran campos relevantes; no todos los campos de auditoría." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=4;fontFamily=Arial;fontSize=16;fontColor=#FFFFFF;fontStyle=0;fillColor=none;strokeColor=none;" parent="1" vertex="1"><mxGeometry x="1262" y="1296" width="1006" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="lvl4_2" name="02 - Inventario y asociaciones"><mxGraphModel dx="2400" dy="1370" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1370" math="0" shadow="0" background="#081523"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title_1" value="02 - Inventario y asociaciones" style="rounded=0;fillColor=#0050EF;strokeColor=#001DBC;fontColor=#FFFFFF;fontSize=27;fontStyle=1;align=left;spacing=16;" parent="1" vertex="1"><mxGeometry x="60" y="35" width="1510" height="52" as="geometry"/></mxCell><mxCell id="txt_2" value="Modelo de activos OT · OneToOne, claves foráneas e historial" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=4;fontFamily=Arial;fontSize=18;fontColor=#BED3E4;fontStyle=0;fillColor=none;strokeColor=none;" parent="1" vertex="1"><mxGeometry x="70" y="90" width="1740" height="35" as="geometry"/></mxCell><mxCell id="bd_3" value="" style="rounded=1;arcSize=8;dashed=1;dashPattern=10 7;strokeColor=#54728C;strokeWidth=2;fillColor=none;" parent="1" vertex="1"><mxGeometry x="55" y="170" width="2290" height="1100" as="geometry"/></mxCell><mxCell id="txt_4" value="assets · 9 modelos del dominio" style="text;html=1;whiteSpac